 5.1.98.2-2
 5.2.1-2
 0:5.2.2-1
 5.2.3-1
 0:5.2.4-1
 1:3.2.3-1
(16 rows)

SELECT min(ver) FROM versions;
   min   
---------
 3.1.4-1
(1 row)

SELECT max(ver) FROM versions;
    max    
-----------
 1:3.2.3-1
(1 row)

-- PK violations
INSERT INTO versions (ver) VALUES ('0:4.1.5-2');
ERROR:  duplicate key value violates unique constraint "versions_pkey"
DETAIL:  Key (ver)=(0:4.1.5-2) already exists.
